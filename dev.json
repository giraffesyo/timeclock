{
  "name": "timeclock",
  "postgres": { "port": 54331 },
  "ports": { "server": 8090, "web": 5174 },
  "env": {
    "PORT": "{port.server}",
    "TIMECLOCK_DATABASE_URL": "{postgres}",
    "TIMECLOCK_TEST_DATABASE_URL": "{postgres_test}",
    "TIMECLOCK_DEV_USER": "dev@example.com",
    "TIMECLOCK_ADMIN_EMAILS": "dev@example.com",
    "TIMECLOCK_AUDITOR_EMAILS": "dev@example.com",
    "TIMECLOCK_VITE_URL": "http://localhost:{port.web}"
  },
  "before": [["sh", "-c", "find web/dist -mindepth 1 ! -name .gitkeep -delete"]],
  "services": [
    {
      "name": "server",
      "build": ["go", "build", "-o", "tmp/timeclock-server", "./cmd/timeclock-server"],
      "run": ["tmp/timeclock-server"],
      "exclude": ["tmp", "web", "tools", "dist", "examples"],
      "extensions": [".go", ".sql"],
      "url": "http://localhost:{port.server}"
    },
    {
      "name": "web",
      "dir": "web",
      "run": ["pnpm", "dev", "--port", "{port.web}"],
      "env": { "TIMECLOCK_SERVER_URL": "http://localhost:{port.server}" }
    }
  ]
}
