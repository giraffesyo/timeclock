# Development only: what `go -C tools tool dev` gives the server. The real
# environment wins, so TIMECLOCK_DEV_USER=you@example.com go -C tools tool dev
# signs you in as someone else.
PORT=8090
TIMECLOCK_DATABASE_URL=postgres://timeclock:timeclock@localhost:54331/timeclock_test?sslmode=disable
TIMECLOCK_DEV_USER=dev@example.com
TIMECLOCK_ADMIN_EMAILS=dev@example.com
TIMECLOCK_VITE_URL=http://localhost:5174
